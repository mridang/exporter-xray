{
  "name": "@mridang/exporter-xray",
  "version": "1.10.2",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npx eslint .",
    "lint:fix": "npx eslint . --fix",
    "prepack": "tsc",
    "test": "jest --verbose --config=jest.config.mjs",
    "test:debug": "jest --verbose --config=jest.config.mjs --detectOpenHandles",
    "test:watch": "npm run test -- --watch"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "keywords": [
    "opentelemetry",
    "nodejs",
    "tracing",
    "profiling",
    "xray",
    "aws"
  ],
  "author": {
    "name": "Mridang Agarwalla",
    "email": "mridang.agarwalla@gmail.com",
    "url": "https://github.com/mridang"
  },
  "files": [
    "dist"
  ],
  "license": "Apache-2.0",
  "description": "OpenTelemetry Exporter that allows the user to send the collected traces to AWS X-Ray",
  "private": false,
  "peerDependencies": {
    "@opentelemetry/api": "^1.0.0",
    "@opentelemetry/id-generator-aws-xray": "^1.0.0",
    "@opentelemetry/propagator-aws-xray": "^1.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mridang/exporter-xray.git"
  },
  "homepage": "https://github.com/mridang/exporter-xray",
  "bugs": "https://github.com/mridang/exporter-xray/issues",
  "dependencies": {
    "@aws-sdk/client-xray": "^3.0.0",
    "@jest/globals": "^30.0.3",
    "@opentelemetry/core": "^3.1.1",
    "@opentelemetry/sdk-trace-base": "^2.12.1",
    "@opentelemetry/semantic-conventions": "^1.25.1",
    "empty-deep": "^1.0.0",
    "error-stack-parser": "^2.1.4"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@mridang/eslint-defaults": "^2.1.0",
    "@opentelemetry/api": "^1.0.0",
    "@opentelemetry/id-generator-aws-xray": "^3.0.1",
    "@opentelemetry/propagator-aws-xray": "^3.0.0",
    "@opentelemetry/resources": "3.1.1",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.0",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@tsconfig/node22": "^22.0.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "jest": "^30.0.3",
    "jest-junit": "^17.0.0",
    "knip": "^6.17.1",
    "prettier": "^3.9.10",
    "semantic-release": "^25.0.1",
    "ts-jest": "^29.4.15",
    "typescript": "~7.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "@eslint/core": "1.2.1",
    "@smithy/util-utf8": "3.0.0"
  },
  "sideEffects": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  }
}
